{
    "name": "ecotone/pulse",
    "type": "project",
    "description": "Ecotone Pulse: a dashboard for Ecotone services connected over the Distributed Bus",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ecotone/amqp": "~2.0.0-beta.6",
        "ecotone/dbal": "~2.0.0-beta.6",
        "ecotone/kafka": "~2.0.0-beta.6",
        "ecotone/redis": "~2.0.0-beta.6",
        "ecotone/sqs": "~2.0.0-beta.6",
        "ecotone/symfony-bundle": "~2.0.0-beta.6",
        "symfony/asset": "^7.4",
        "symfony/asset-mapper": "^7.4",
        "symfony/cache": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/runtime": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "symfony/yaml": "^7.4",
        "twig/twig": "^3.0",
        "symfony/clock": "^7.4",
        "symfony/stopwatch": "^7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "symfony/browser-kit": "^7.4",
        "symfony/css-selector": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "scripts": {
        "tests:ci": [
            "vendor/bin/phpstan analyse --no-progress",
            "vendor/bin/phpunit --no-coverage"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        }
    }
}