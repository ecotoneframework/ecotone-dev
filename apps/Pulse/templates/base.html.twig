<!DOCTYPE html>
<html lang="en" data-pulse-version="{{ pulse.version }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Ecotone Pulse{% endblock %}</title>
    <script>try{var t=localStorage.getItem('pulse-theme');if(t==='light'||t==='dark'){document.documentElement.dataset.theme=t}}catch(e){}</script>
    <script>try{if(localStorage.getItem('pulse-concepts')==='off'){document.documentElement.dataset.concepts='off'}}catch(e){}</script>
    <script>try{var r=document.documentElement,n=new Date(),d=n.getFullYear()+'-'+String(n.getMonth()+1).padStart(2,'0')+'-'+String(n.getDate()).padStart(2,'0');r.dataset.introDay=d;localStorage.setItem('ecotone-pulse.probe','1');localStorage.removeItem('ecotone-pulse.probe');if(localStorage.getItem('ecotone-pulse.intro-seen-on')!==d){r.classList.add('intro-pending')}}catch(e){}</script>
    {% block head %}{% endblock %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>
<body>
<div class="intro" data-intro aria-hidden="true">
    {% include '_logo.html.twig' with {class: 'intro-logo', id: 'intro'} %}
    <svg class="intro-heart" data-intro-heart viewBox="0 0 32 29" xmlns="http://www.w3.org/2000/svg" focusable="false"><path d="M16 28C3 18 0 12 0 8a8 8 0 0 1 16-2 8 8 0 0 1 16 2c0 4-3 10-16 20Z" fill="currentColor"/></svg>
</div>
<a class="skip" href="#content">Skip to content</a>
<header class="topbar">
    <a class="brand" href="{{ path('home') }}">{% include '_logo.html.twig' with {class: 'brand-logo', id: 'brand', decorative: true} %}<span class="brand-title">Ecotone Pulse</span></a>
    {% if pulse.runsOnTestingLicence %}<span class="demo-version" data-demo-version title="Pulse runs on Ecotone's testing licence. Your own services need your Ecotone Enterprise licence key.">Demo Version</span>{% endif %}
    {% set current = app.request.attributes.get('_route') %}
    {% set deadLetterFailures = dead_letter_failures() %}
    {% set navArchitecture = [{label: 'Flow graph', route: 'flow_graph'}, {label: 'Topology', route: 'topology'}, {label: 'Catalogue', route: 'catalogue'}] %}
    {% set navSections = [
        {label: 'Overview', route: 'home', routes: ['home']},
        {label: 'Services', route: 'services', routes: ['services', 'service_hub', 'service_channels', 'service_configuration', 'service_projections']},
        {label: 'Failed messages', key: 'failures', route: 'dead_letters', routes: ['dead_letters', 'dead_letter', 'dead_letter_actions'], badge: deadLetterFailures},
        {label: 'Traces', route: 'traces', routes: ['traces', 'trace_list', 'trace_detail']},
        {label: 'Architecture', route: 'flow_graph', routes: navArchitecture|map(tab => tab.route)},
    ] %}
    <nav aria-label="Main" data-main-nav>
        {% for navSection in navSections %}
            <a href="{{ path(navSection.route) }}" data-nav-section="{{ navSection.key ?? navSection.label|lower }}"{% if current in navSection.routes %} class="active" aria-current="{{ current == navSection.route ? 'page' : 'true' }}"{% endif %}>{{ navSection.label }}{% if navSection.badge is defined and navSection.badge > 0 %}<span class="badge" data-nav-dead-letters title="{{ navSection.badge }} {{ navSection.badge == 1 ? 'failure group' : 'failure groups' }} of failed messages">{{ navSection.badge }}<span class="visually-hidden"> {{ navSection.badge == 1 ? 'failure group' : 'failure groups' }}</span></span>{% endif %}</a>
        {% endfor %}
    </nav>
    <div class="topbar-tools">
        <a class="btn connect-link" href="{{ path('connect') }}" data-nav-connect{% if current == 'connect' %} aria-current="page"{% endif %}>+ Connect a service</a>
        <button type="button" class="concepts-toggle" data-concepts-toggle aria-pressed="true">Explain concepts</button>
        <button type="button" class="theme-toggle" data-theme-toggle>Theme</button>
    </div>
</header>
<main id="content">
{% block crumbs %}{% endblock %}
{% if current in navArchitecture|map(tab => tab.route) %}
    {% set navScopedService = app.request.query.get('service') %}
    <nav aria-label="Architecture" class="subnav" data-architecture-tabs>
        {% for tab in navArchitecture %}
            <a href="{{ path(tab.route, navScopedService ? {service: navScopedService} : {}) }}" data-architecture-tab="{{ tab.route }}"{% if current == tab.route %} aria-current="page"{% endif %}>{{ tab.label }}</a>
        {% endfor %}
    </nav>
{% endif %}
{% block body %}{% endblock %}
</main>
</body>
</html>
