<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Ecotone Pulse{% endblock %}</title>
    {% block head %}{% endblock %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>
<body>
<a class="skip" href="#content">Skip to content</a>
<header class="topbar">
    <span class="brand">Ecotone Pulse</span>
    <nav>
        {% set current = app.request.attributes.get('_route') %}
        <a href="{{ path('services') }}"{% if current == 'services' %} class="active"{% endif %}>Services</a>
        {% set deadLetterTotal = dead_letter_total() %}
        <a href="{{ path('dead_letters') }}"{% if current == 'dead_letters' or current == 'dead_letter' %} class="active"{% endif %}>Dead letters{% if deadLetterTotal > 0 %}<span class="badge" data-nav-dead-letters>{{ deadLetterTotal }}</span>{% endif %}</a>
        <a href="{{ path('flow_graph') }}"{% if current == 'flow_graph' %} class="active"{% endif %}>Flow graph</a>
        <a href="{{ path('traces') }}"{% if current starts with 'trace' %} class="active"{% endif %}>Traces</a>
        <a href="{{ path('topology') }}"{% if current == 'topology' %} class="active"{% endif %}>Topology</a>
        <a href="{{ path('catalogue') }}"{% if current == 'catalogue' %} class="active"{% endif %}>Catalogue</a>
    </nav>
</header>
<main id="content">{% block body %}{% endblock %}</main>
</body>
</html>
