<p>Add the class to the service and consume its request channel. Pulse side: <code data-pulse-services>PULSE_SERVICES={{ servicesEntry }}</code> (add it to the existing list, separated by commas).</p>
{% for framework, snippet in snippets %}
    <details class="card" data-snippet="{{ framework }}"{% if loop.first %} open{% endif %}>
        <summary>{{ snippet.title }}</summary>
        <pre class="mono" data-php>{{ snippet.php }}</pre>
        <pre class="mono" data-wiring>{{ snippet.wiring }}</pre>
    </details>
{% endfor %}
