{% extends 'base.html.twig' %}

{% block title %}Connect a service · Ecotone Pulse{% endblock %}

{% block body %}
    <h1>Connect a service</h1>
    <form method="get" action="{{ path('connect') }}" class="filters card">
        <label for="c-service">Service name <input id="c-service" type="text" name="service" value="{{ service }}" list="known-services"></label>
        <datalist id="known-services">{% for name in known %}<option value="{{ name }}">{% endfor %}</datalist>
        <button type="submit" class="pri">Generate</button>
    </form>
    {% if invalid is not null %}
        <p class="notice" data-invalid-service>"{{ invalid }}" cannot be a service name in generated code. Use only the characters [A-Za-z0-9_.-], the characters a name in PULSE_SERVICES can have without quoting.</p>
    {% else %}
        {% include 'connect/_snippets.html.twig' %}
    {% endif %}
{% endblock %}
