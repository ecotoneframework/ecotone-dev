{% extends 'base.html.twig' %}

{% block title %}Confirm delete · Ecotone Pulse{% endblock %}

{% macro dead_letters(count) %}{{ count }} {{ count == 1 ? 'failed message' : 'failed messages' }}{% endmacro %}

{% block body %}
    {% import _self as page %}
    {% if scopeService %}
        {% set scope = scopeService|split('@', 2) %}
        {% include '_breadcrumbs.html.twig' with {service: scope[0], tenant: scope[1] ?? null, trail: [{label: 'Failed messages', href: path('dead_letters', filter.toQuery|merge({service: scopeService}))}, {label: 'Confirm delete'}]} only %}
    {% else %}
        {% include '_breadcrumbs.html.twig' with {crumbs: [{label: 'Home', href: path('home')}, {label: 'Failed messages', href: path('dead_letters', filter.toQuery)}, {label: 'Confirm delete'}]} only %}
    {% endif %}
    <h1>Delete failed messages</h1>
    <form method="post" action="{{ path('dead_letter_actions') }}" data-confirm-delete>
        {% if deleteFailure %}
            <p>This deletes every stored failed message of this failure group in {{ services|join(', ') }}{% if failure %}: <strong data-failure-label>{{ failure.exceptionClass }} at {{ failure.exceptionFile ? (failure.exceptionFile|split('/')|last) ~ ':' ~ failure.exceptionLine : 'an unknown location' }} for {{ failure.messageName ?: '(unnamed)' }}</strong>, {{ page.dead_letters(failure.count) }}{% endif %}, including those beyond the latest 100 shown in the list. Failed messages of the same exception under another message name stay. Their messages are not handled again, and it cannot be undone.</p>
            <input type="hidden" name="deleteFailure" value="{{ deleteFailure }}">
            <button type="submit" class="danger">Delete {{ failure ? page.dead_letters(failure.count) : 'every failed message of this failure group' }}</button>
        {% elseif selection %}
            {% set count = 0 %}
            {% for ids in selection %}{% set count = count + ids|length %}{% endfor %}
            <p>This deletes the {{ page.dead_letters(count) }} you selected in {{ services|join(', ') }}. Their messages are not handled again, and it cannot be undone.</p>
            <input type="hidden" name="scope" value="ids">
            {% for service, ids in selection %}{% for id in ids %}<input type="hidden" name="selected[{{ service }}][]" value="{{ id }}">{% endfor %}{% endfor %}
            <button type="submit" class="danger">Delete {{ page.dead_letters(count) }}</button>
        {% else %}
            {% set labels = {messageName: 'Message name', exceptionClass: 'Exception class', failureId: 'Failure group', failedFrom: 'Failed from (UTC)', failedTo: 'Failed to (UTC)'} %}
            <p>This deletes every stored failed message of {{ services|join(', ') }} matching the filter below{% if matchingCount is not null %}, {{ page.dead_letters(matchingCount) }} in the latest snapshot{% endif %}, including those beyond the latest 100 shown in the list. Their messages are not handled again, and it cannot be undone.</p>
            <p class="filter-chips" aria-label="Filter">
                {% for name, value in filter.toQuery %}{% if labels[name] is defined %}<span class="chip" data-filter-chip>{{ labels[name] }}: <code>{{ value }}</code></span> {% endif %}{% endfor %}
            </p>
            <input type="hidden" name="scope" value="filter">
            {% for name, value in filter.toQuery %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endfor %}
            <button type="submit" class="danger">Delete {{ matchingCount is null ? 'every matching failed message' : page.dead_letters(matchingCount) }}</button>
        {% endif %}
        <input type="hidden" name="action" value="delete">
        <input type="hidden" name="confirm" value="1">
        <a href="{{ path('dead_letters', filter.toQuery) }}">Cancel</a>
    </form>
{% endblock %}
