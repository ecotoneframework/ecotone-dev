{% extends 'base.html.twig' %}

{% block title %}Dead letters · Ecotone Pulse{% endblock %}

{% block head %}
    {% if waiting %}<meta http-equiv="refresh" content="3">{% endif %}
{% endblock %}

{% block body %}
    <h1>Dead letters</h1>

    <form method="get" action="{{ path('dead_letters') }}" class="filters" data-filter-form>
        <label>Service
            <select name="service">
                <option value="">All services</option>
                {% for name in serviceNames %}<option value="{{ name }}"{% if filter.service == name %} selected{% endif %}>{{ name }}</option>{% endfor %}
            </select>
        </label>
        <label>Message name <input type="text" name="messageName" value="{{ filter.messageName }}"></label>
        <label>Exception class <input type="text" name="exceptionClass" value="{{ filter.exceptionClass }}"></label>
        <label>Failed from (UTC) <input type="datetime-local" step="1" name="failedFrom" value="{{ filter.failedFrom }}"></label>
        <label>Failed to (UTC) <input type="datetime-local" step="1" name="failedTo" value="{{ filter.failedTo }}"></label>
        <button type="submit">Filter</button>
    </form>

    <p class="muted" data-list-note>The list shows the latest 100 dead letters of each service and is filtered on that snapshot. Actions on a filter apply to all stored dead letters of the service.</p>

    {% if notice %}{% include 'dead_letters/_notice.html.twig' %}{% endif %}

    {% for group in sharedStores %}
        <p class="drift" data-shared-store>{{ group|join(', ') }} share one dead letter store: they report the same dead letters, so act through one of them. A filter action across services is sent only to {{ group|first }}.</p>
    {% endfor %}

    <form method="post" action="{{ path('dead_letter_actions') }}" data-selection-form>
    <input type="hidden" name="scope" value="ids">
    {% for service in services %}
        <section class="card" data-service-section="{{ service.service }}">
            <h2>{{ service.service }}</h2>
            {% if not service.configured %}
                <p class="muted" data-not-configured="{{ service.service }}">{% if service.status.hasSnapshot %}dead letter not configured{% else %}no snapshot yet ({{ service.status.status.name|lower }}){% endif %}</p>
            {% else %}
                <p>Total: <strong data-service-total="{{ service.service }}">{{ service.total }}</strong> <span class="muted">({{ service.status.status.name|lower }})</span></p>
                <ul class="groups">
                    {% for group in service.groups %}
                        <li data-group data-service="{{ service.service }}" data-message-name="{{ group.messageName }}">
                            <a href="{{ path('dead_letters', filter.toQuery|merge({service: service.service, messageName: group.messageName, exceptionClass: group.exceptionClass})) }}">{{ group.messageName ?: '(unnamed)' }} · {{ group.exceptionClass }} · {{ group.count }}</a>
                        </li>
                    {% endfor %}
                </ul>
                <table>
                    <thead><tr><th></th><th>Message</th><th>Exception</th><th>Failed at</th></tr></thead>
                    <tbody>
                    {% for entry in service.entries %}
                        <tr data-dead-letter data-service="{{ service.service }}" data-message-id="{{ entry.messageId }}" data-message-name="{{ entry.messageName }}">
                            <td><input type="checkbox" name="selected[{{ service.service }}][]" value="{{ entry.messageId }}"></td>
                            <td><a href="{{ path('dead_letter', {service: service.service, messageId: entry.messageId}) }}">{{ entry.messageName ?: '(unnamed)' }}</a></td>
                            <td>{{ entry.exceptionClass }}: {{ entry.exceptionMessage }}</td>
                            <td>{{ entry.failedAt|date('Y-m-d H:i:s', 'UTC') }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                <label>Replay to channel
                    <select name="targetChannel[{{ service.service }}]">
                        <option value="">original channel</option>
                        {% for name in channels[service.service] ?? [] %}<option value="{{ name }}">{{ name }}</option>{% endfor %}
                    </select>
                </label>
            {% endif %}
        </section>
    {% endfor %}
    <p>
        <button type="submit" name="action" value="replay">Replay selected</button>
        <button type="submit" name="action" value="delete">Delete selected</button>
    </p>
    </form>

    <form method="post" action="{{ path('dead_letter_actions') }}" data-filter-action-form>
        <h2>Everything matching the filter</h2>
        <input type="hidden" name="scope" value="filter">
        {% for name, value in filter.toQuery %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endfor %}
        {% if filter.service and channels[filter.service] is defined %}
            <label>Replay to channel
                <select name="targetChannel">
                    <option value="">original channel</option>
                    {% for name in channels[filter.service] %}<option value="{{ name }}">{{ name }}</option>{% endfor %}
                </select>
            </label>
        {% endif %}
        <button type="submit" name="action" value="replay">Replay matching</button>
        <button type="submit" name="action" value="delete">Delete matching</button>
    </form>
{% endblock %}
