{% extends 'base.html.twig' %}

{% block title %}Flow graph · Ecotone Pulse{% endblock %}

{% block head %}
    {% if waiting %}<meta http-equiv="refresh" content="3">{% endif %}
{% endblock %}

{% block importmap %}{{ importmap(['app', 'graph']) }}{% endblock %}

{% block crumbs %}
    {% include '_breadcrumbs.html.twig' with {service: scope.selected, trail: [{label: 'Flow graph'}]} only %}
{% endblock %}

{% block body %}
    <h1>Flow graph</h1>

    {% if trace %}
        <div class="flow-trace" data-trace-banner>
            {% embed '_verdict.html.twig' with {status: summary.status, reason: summary.reason, sentence: summary.sentence, trace: trace, traceEmpty: traceEmpty, waiting: waiting, traceStates: traceStates} only %}
                {% block meta %}
                    <p class="verdict-meta" data-verdict-meta>Highlighting trace <a href="{{ path('trace_detail', {traceId: trace.traceId}) }}"><code>{{ trace.traceId }}</code></a>{% if not traceEmpty %} ({{ trace.status }}){% endif %}.
                        {% if traceEmpty %}<span data-trace-no-spans>{% if waiting %}Waiting for the services to answer…{% else %}No service stored a span of this trace id.{% endif %}</span>{% endif %}
                    </p>
                    {% for state in traceStates %}
                        {% if state.state in ['waiting', 'not_answering', 'refused'] %}
                            <p class="drift" data-trace-service-state="{{ state.service }}">{{ state.service }}: {{ state.state == 'waiting' ? 'pending, waiting for the answer…' : (state.state == 'refused' ? 'refused this query: ' ~ state.failure : 'not answering for this query.') }}</p>
                        {% endif %}
                    {% endfor %}
                {% endblock %}
            {% endembed %}
        </div>
    {% else %}
        {% embed '_verdict.html.twig' with {status: summary.status, reason: summary.reason, sentence: summary.sentence, checked: summary.checked} only %}
            {% block meta %}
                <p class="verdict-meta" data-verdict-meta>Built from each service's last answer: handlers and channels declared by attributes, Distributed Bus routes, and sends inferred from handler source code.</p>
                {% if checked %}<p class="verdict-meta" data-flow-checked>Nothing to look at: every command and query sent has a handler, and every message received over the Distributed Bus has a sender in the graph.</p>{% endif %}
            {% endblock %}
        {% endembed %}
    {% endif %}

    {% include 'graph/_notices.html.twig' with {notices: notices} only %}

    {% if findings %}
        <div class="flow-findings" data-flow-findings>
            {% for finding in findings|slice(0, 3) %}
                {% include '_problem.html.twig' with finding only %}
            {% endfor %}
            {% if findings|length > 3 %}
                {% set more = findings|length - 3 %}
                <details class="flow-more-findings" data-flow-more-findings data-disclosure="flow.more-findings">
                    <summary>{{ more }} more {{ more == 1 ? 'finding' : 'findings' }}</summary>
                    {% for finding in findings|slice(3) %}
                        {% include '_problem.html.twig' with finding only %}
                    {% endfor %}
                </details>
            {% endif %}
        </div>
    {% endif %}
    {% if doubts %}
        <details class="flow-doubts" data-flow-doubts data-disclosure="flow.doubts">
            <summary>{{ doubts|length }} {{ doubts|length == 1 ? 'thing' : 'things' }} Pulse could not confirm from the source code · info</summary>
            {% for finding in doubts %}
                {% include '_problem.html.twig' with finding only %}
            {% endfor %}
        </details>
    {% endif %}

    {% if services is not empty %}
        <p class="flow-reading" data-flow-reading>
            {% if trace %}{{ summary.graphSentence }} {% endif %}
            {% if overview %}
            Each box is a service. An arrow counts the {% include '_concept.html.twig' with {term: 'command', text: 'commands'} only %}, {% include '_concept.html.twig' with {term: 'event', text: 'events'} only %} and messages one service sends another across the {% include '_concept.html.twig' with {term: 'distributed-bus', text: 'Distributed Bus'} only %}, and a dashed arrow counts the replies. Click a service to draw its handlers with each command, event and {% include '_concept.html.twig' with {term: 'query', text: 'query'} only %}.
            {% else %}
            Each box is a {% include '_concept.html.twig' with {term: 'command', text: 'command'} only %}, an {% include '_concept.html.twig' with {term: 'event', text: 'event'} only %} or a {% include '_concept.html.twig' with {term: 'query', text: 'query'} only %}, or the handler that takes it, and an arrow points from what sends to what handles.
            Thick arrows go through an asynchronous channel or across the {% include '_concept.html.twig' with {term: 'distributed-bus', text: 'Distributed Bus'} only %} to another service; dashed arrows are inferred from source code, so a send Pulse cannot read draws none.
            {% endif %}
        </p>
    {% endif %}

    <div class="flow-toolbar">
        {% include 'graph/_scope.html.twig' with {scope: scope, carry: carried|filter((value, name) => name != 'service')|merge(focus ? {focus: focus.parameter} : {})} only %}
        <form method="get" action="{{ path('flow_graph') }}" class="flow-find" role="search" data-flow-find>
            <label for="flow-find">Find a node</label>
            <input id="flow-find" type="search" name="find" list="flow-node-names" value="{{ find }}" autocomplete="off">
            {% include 'graph/_carried.html.twig' with {carry: carried} only %}
            <button type="submit">Follow</button>
            <datalist id="flow-node-names">{% for name in nodeNames %}<option value="{{ name }}"></option>{% endfor %}</datalist>
        </form>
    </div>
    {% if find != '' %}
        {% if found is empty %}
            <p class="notice" data-find-none>No node matches "{{ find }}". Names are matched anywhere in the label, ignoring case; the suggestions under the box list every node.</p>
        {% else %}
            <section class="card" aria-labelledby="find-heading">
                <h2 id="find-heading">{{ found|length }} nodes match "{{ find }}"</h2>
                <ul data-find-results>{% for step in found %}<li><a href="{{ step.href }}">{{ step.label }}</a> <span class="muted">{{ step.kind }} · {{ step.service }}</span></li>{% endfor %}</ul>
            </section>
        {% endif %}
    {% endif %}
    {% if focus %}
        <section class="card focus" data-focus aria-labelledby="focus-heading">
            <h2 id="focus-heading">Following {{ focus.label }} <span class="muted">in {{ focus.service }}</span></h2>
            <p class="muted">Only what led to it and what it causes, as far as the services report it, is drawn: a send whose routing key is computed at runtime reaches the service it is sent to, but not the message there. Click a node, or a step listed under the graph, to re-centre on it, or <a href="{{ focus.clearUrl }}" data-focus-clear>show everything</a>. </p>
            <p><a class="btn" href="{{ path('catalogue_node', {service: focus.service, id: focus.node}) }}" data-focus-page>Open the page of {{ focus.label }}</a></p>
        </section>
    {% endif %}

    {% if services is empty %}
        {% include '_empty.html.twig' with {cause: 'nothing-yet', hook: 'flow-no-services', sentence: 'No service has answered with its flow graph yet: the graph appears once a service running PulseConfiguration answers Pulse.', action: {label: 'See which services Pulse asks and how they answer', href: path('services')}} only %}
    {% else %}
        {% embed '_section.html.twig' with {key: 'flow.services', hook: 'flow-services', title: 'Services', summary: shown|length ~ ' of ' ~ services|length ~ ' shown' ~ (collapsed ? ' · ' ~ collapsed|length ~ ' collapsed' : ''), status: 'ok', open: false, services: services, shown: shown, collapsed: collapsed, collapseUrls: collapseUrls, carried: carried} only %}
            {% block body %}
                <form method="get" class="service-toggles">
                    {% include 'graph/_carried.html.twig' with {carry: carried|filter((value, name) => name != 'service')} only %}
                    {% for service in services %}
                        <label><input type="checkbox" name="services[]" value="{{ service }}"{% if service in shown %} checked{% endif %}> {{ service }}</label>{% if collapseUrls[service] is defined %} <a class="collapse-link" href="{{ collapseUrls[service] }}" {% if service in collapsed %}data-expand="{{ service }}" aria-label="Expand {{ service }}">expand{% else %}data-collapse="{{ service }}" aria-label="Collapse {{ service }}">collapse{% endif %}</a>{% endif %}
                    {% endfor %}
                    <button type="submit">Show</button>
                </form>
                <p class="muted">Tick the services to draw. Collapse draws a service as one box, so the arrows into and out of it stay readable.</p>
            {% endblock %}
        {% endembed %}
        <p class="muted graph-view">
            {% if overview %}<span data-flow-overview>Service overview: one node per service, arrows are distributed commands, events and messages.</span> Click a service to see its flow, or <a href="{{ detailUrl }}">show every service in detail</a>.
            {% elseif services|length > 1 %}<a href="{{ overviewUrl }}">Show the service overview</a>{% endif %}
            {% if not overview %}{% if services|length > 1 %} · {% endif %}{% if not focus %}Click a node to follow it: only what led to it and everything it causes stays drawn. {% endif %}{% if foldChannels %}<a href="{{ foldUrl }}" data-unfold-channels>Show channels</a>{% else %}<a href="{{ foldUrl }}" data-fold-channels>Fold asynchronous channels into arrows</a>{% endif %}{% endif %}
        </p>
        {% include 'graph/_diagram.html.twig' with {diagram: diagram, hook: 'flow-graph', label: 'Flow graph'} only %}
        {% if traceSteps is not empty %}
            <details class="card flush trace-drawer" data-trace-drawer data-disclosure="flow.trace-drawer" open>
                <summary><b>Trace step by step</b> <span class="summary-state">{{ traceSteps|length }} steps{% if traceDuration %} · {{ traceDuration }} from first to last{% endif %}{% if traceWaited %} · longest wait before a step {{ traceWaited }}{% endif %}</span></summary>
                <p class="trace-drawer-note" data-trace-drawer-note>{% if overview %}The graph above is the service overview, so the steps have no numbers here: <a href="{{ detailUrl }}" data-trace-drawer-detail>draw every node</a> to see each step on its node. {% else %}A number is the node the step passed on the graph: press it to bring that node into view. A node the trace visits again keeps its number, and a dot means no node drawn above matches the step. {% endif %}"Waited" is the time before the step ran, in a queue or because the message was sent with a delay. "Took" includes the steps a step started, indented under it. <a href="{{ path('trace_detail', {traceId: trace.traceId}) }}" data-trace-drawer-full>Open the full trace</a> for attributes, errors and the flame graph.</p>
                <div class="trace-drawer-body" tabindex="0" role="region" aria-label="Steps of the trace">
                    <table class="trace-steps">
                        <thead><tr><th scope="col">On graph</th><th scope="col">Service</th><th scope="col">Step</th><th scope="col" class="num">Waited</th><th scope="col" class="num">Took</th><th scope="col" class="timeline">Timeline</th></tr></thead>
                        <tbody>
                        {% set total = max(1, traceTotalMicro) %}
                        {% for step in traceSteps %}
                            <tr{% if step.step %} data-trace-step="{{ step.step }}"{% endif %} data-trace-step-status="{{ step.status }}"{% if step.hopFrom %} data-trace-step-hop{% endif %} class="status-{{ step.status }}">
                                <td>{% if step.step %}<button type="button" class="dn-step-ref{{ step.failed ? ' failed' : (step.pending ? ' pending' : '') }}" data-trace-step-button aria-label="Show step {{ step.step }} on the graph">{{ step.step }}</button>{% else %}<span class="muted" aria-label="not on the graph">·</span>{% endif %}</td>
                                <td>{{ step.service }}{% if step.hopFrom %} <span class="chip" title="This step crossed from {{ step.hopFrom }} to {{ step.service }}">⇢ from {{ step.hopFrom }}</span>{% endif %}</td>
                                <td style="padding-left: {{ 0.5 + step.depth * 0.9 }}em"><span class="mono">{{ step.name|breakable }}</span>{% if step.failed %} <span class="pill bad">failed</span>{% if step.error %} <span class="drift">{{ step.error|length > 140 ? step.error|slice(0, 140) ~ '…' : step.error }}</span>{% endif %}{% elseif step.pending %} <span class="pill wait">pending</span>{% endif %}</td>
                                <td class="num">{{ step.waitLabel }}</td>
                                <td class="num">{{ step.durationLabel }}</td>
                                {% set barWidth = max(0.8, (step.durationMicro / total * 100)|round(3)) %}{% set barLeft = min((step.offsetMicro / total * 100)|round(3), 100 - barWidth) %}
                                <td class="timeline"><div class="track">{% if step.waitMicro > 0 %}<span class="wait-bar" title="waited {{ step.waitLabel }} in a queue" style="left: {{ max(0, ((step.offsetMicro - step.waitMicro) / total * 100)|round(3)) }}%; width: {{ (step.waitMicro / total * 100)|round(3) }}%"></span>{% endif %}<span class="bar{{ step.failed ? ' failed' : (step.pending ? ' pending' : ' passed') }}" style="left: {{ barLeft }}%; width: {{ barWidth }}%"></span></div></td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </details>
        {% endif %}
        {% if focus %}
            <details class="card focus" data-focus-steps data-disclosure="flow.focus-steps">
                <summary>Steps: {{ focus.upstream|length }} before, {{ focus.downstream|length }} after</summary>
                <p class="muted" data-focus-order>Both lists are ordered by distance from {{ focus.label }}, nearest last before it and nearest first after it; parallel branches at the same distance sit together, not in the order they run.</p>
                <div class="focus-steps">
                    <div>
                        <h3>What led here</h3>
                        {% if focus.upstream is empty %}<p class="muted">Nothing: this is where the flow starts.</p>{% else %}
                        <ol data-focus-upstream>{% for step in focus.upstream %}<li><a href="{{ step.href }}">{{ step.label }}</a> <span class="muted">{{ step.kind }} · {{ step.service }}</span></li>{% endfor %}</ol>
                        {% endif %}
                    </div>
                    <div>
                        <h3>What happens next</h3>
                        {% if focus.downstream is empty %}<p class="muted">Nothing: the flow ends here.</p>{% else %}
                        <ol data-focus-downstream>{% for step in focus.downstream %}<li><a href="{{ step.href }}">{{ step.label }}</a> <span class="muted">{{ step.kind }} · {{ step.service }}</span></li>{% endfor %}</ol>
                        {% endif %}
                    </div>
                </div>
            </details>
        {% endif %}
        <ul class="graph-goto" aria-label="Go to a service's failures and traces" data-graph-goto>
            {% for service in services %}
                <li data-service-link="{{ service }}"><b>{{ service }}</b>: <a data-dead-letters href="{{ path('dead_letters', {service: service}) }}">Dead letters of {{ service }}</a> · <a data-traces href="{{ path('traces', {service: service}) }}">Traces of {{ service }}</a></li>
            {% endfor %}
        </ul>
        {% embed '_section.html.twig' with {key: 'flow.legend', hook: 'graph-legend', title: 'Legend', summary: '5 kinds of node, 4 kinds of arrow, 4 trace marks', status: 'ok', open: trace is not null} only %}
            {% block body %}
                <ul class="legend-items">
                    <li data-legend="command">{% include 'graph/_kind.html.twig' with {family: 'command', kind: 'command', label: 'Command'} only %} asks for one thing to be done</li>
                    <li data-legend="event">{% include 'graph/_kind.html.twig' with {family: 'event', kind: 'event', label: 'Event'} only %} says something happened</li>
                    <li data-legend="query">{% include 'graph/_kind.html.twig' with {family: 'query', kind: 'query', label: 'Query'} only %} asks for data</li>
                    <li data-legend="handler">{% include 'graph/_kind.html.twig' with {family: 'handler', kind: 'commandHandler', label: 'Command handler'} only %} the code that takes a message, named Class::method</li>
                    <li data-legend="channel">{% include 'graph/_kind.html.twig' with {family: 'channel', kind: 'channel', label: 'Channel'} only %} where an asynchronous message waits</li>
                </ul>
                <ul class="legend-items">
                    <li data-legend="declared"><b>→</b> thin: declared by an attribute or the Service Map</li>
                    <li data-legend="asynchronous"><b>⟹</b> thick: {% include '_concept.html.twig' with {term: 'asynchronous-arrow', text: 'asynchronous or distributed'} only %}</li>
                    <li data-legend="inferred"><b>⇢</b> dashed: {% include '_concept.html.twig' with {term: 'inferred-arrow', text: 'inferred from source code'} only %}</li>
                    <li data-legend="reply"><b>⇢</b> labelled reply: the answer of a distributed message going back</li>
                </ul>
                <ul class="legend-items">
                    <li data-legend="passed"><span class="pill ok sq">passed</span> the trace went through, numbered in the order it got there</li>
                    <li data-legend="pending"><span class="pill wait sq">pending</span> sent, not processed yet</li>
                    <li data-legend="failed"><span class="pill bad sq">failed</span> the step failed</li>
                    <li data-legend="crossed"><b class="ok">━</b> arrow the trace crossed</li>
                </ul>
            {% endblock %}
        {% endembed %}
    {% endif %}
{% endblock %}
