{% extends 'base.html.twig' %}

{% block title %}Flow graph · Ecotone Pulse{% endblock %}

{% block head %}
    {% if waiting %}<meta http-equiv="refresh" content="3">{% endif %}
{% endblock %}

{% block importmap %}{{ importmap(['app', 'graph']) }}{% endblock %}

{% block body %}
    <h1>Flow graph</h1>
    <p class="muted">Every service's message flow, joined along distributed commands and events. Dashed arrows are inferred from source code.</p>
    {% include 'graph/_notices.html.twig' %}
    {% if trace %}
        <section class="card" data-trace-banner>
            <p>Highlighting trace <a href="{{ path('trace_detail', {traceId: trace.traceId}) }}"><code>{{ trace.traceId }}</code></a>{% if not traceEmpty %} ({{ trace.status }}){% endif %}.
            {% if traceEmpty %}<span data-trace-no-spans>{% if waiting %}Waiting for the services to answer…{% else %}No service stored a span of this trace id.{% endif %}</span>{% endif %}
            </p>
            <p class="muted">Green: passed · amber dashed: sent but not processed yet · red: failed. Thick arrows: the trace crossed them. Durations are the longest step through the node.</p>
            {% for state in traceStates %}
                {% if state.state in ['waiting', 'not_answering', 'refused'] %}
                    <p class="drift" data-trace-service-state="{{ state.service }}">{{ state.service }}: {{ state.state == 'waiting' ? 'pending, waiting for the answer…' : (state.state == 'refused' ? 'refused this query: ' ~ state.failure : 'not answering for this query.') }}</p>
                {% endif %}
            {% endfor %}
        </section>
    {% endif %}
    {% include 'graph/_scope.html.twig' with {carry: carried|filter((value, name) => name != 'service')|merge(focus ? {focus: focus.parameter} : {})} %}
    <form method="get" action="{{ path('flow_graph') }}" class="flow-find" role="search" data-flow-find>
        <label for="flow-find">Find a node</label>
        <input id="flow-find" type="search" name="find" list="flow-node-names" value="{{ find }}" autocomplete="off">
        {% include 'graph/_carried.html.twig' with {carry: carried} only %}
        <button type="submit">Follow</button>
        <datalist id="flow-node-names">{% for name in nodeNames %}<option value="{{ name }}"></option>{% endfor %}</datalist>
    </form>
    {% if find != '' %}
        {% if found is empty %}
            <p class="notice" data-find-none>No node matches "{{ find }}". Names are matched anywhere in the label, ignoring case; the suggestions under the box list every node.</p>
        {% else %}
            <section class="card" aria-labelledby="find-heading">
                <h2 id="find-heading">{{ found|length }} nodes match "{{ find }}"</h2>
                <ul data-find-results>{% for step in found %}<li><a href="{{ step.href }}">{{ step.label }}</a> <span class="muted">{{ step.kind }} · {{ step.service }}</span></li>{% endfor %}</ul>
            </section>
        {% endif %}
    {% endif %}
    {% if focus %}
        <section class="card focus" data-focus aria-labelledby="focus-heading">
            <h2 id="focus-heading">Following {{ focus.label }} <span class="muted">in {{ focus.service }}</span></h2>
            <p class="muted">Only what led to it and everything it causes is drawn. Click a node, or a step listed under the graph, to re-centre on it, or <a href="{{ focus.clearUrl }}" data-focus-clear>show everything</a>.</p>
        </section>
    {% endif %}
    <form method="get" class="service-toggles">
        {% include 'graph/_carried.html.twig' with {carry: carried|filter((value, name) => name != 'service')} only %}
        {% for service in services %}
            <label><input type="checkbox" name="services[]" value="{{ service }}"{% if service in shown %} checked{% endif %}> {{ service }}</label>{% if collapseUrls[service] is defined %} <a class="collapse-link" href="{{ collapseUrls[service] }}" {% if service in collapsed %}data-expand="{{ service }}" aria-label="Expand {{ service }}">expand{% else %}data-collapse="{{ service }}" aria-label="Collapse {{ service }}">collapse{% endif %}</a>{% endif %}
        {% endfor %}
        <button type="submit">Show</button>
    </form>
    {% if services is empty %}
        <p class="muted">No service has answered yet.</p>
    {% else %}
        <p class="muted graph-view">
            {% if overview %}<span data-flow-overview>Service overview: one node per service, arrows are distributed commands, events and messages.</span> Click a service to see its flow, or <a href="{{ detailUrl }}">show every service in detail</a>.
            {% elseif services|length > 1 %}<a href="{{ overviewUrl }}">Show the service overview</a>{% endif %}
            {% if not overview %}{% if services|length > 1 %} · {% endif %}{% if foldChannels %}<a href="{{ foldUrl }}" data-unfold-channels>Show channels</a>{% else %}<a href="{{ foldUrl }}" data-fold-channels>Fold asynchronous channels into arrows</a>{% endif %}{% endif %}
        </p>
        <pre class="mermaid" data-flow-graph data-graph-nodes="{{ nodes|json_encode }}">{{ diagram }}</pre>
        {% if focus %}
            <details class="card focus" data-focus-steps>
                <summary>Steps: {{ focus.upstream|length }} before, {{ focus.downstream|length }} after</summary>
                <div class="focus-steps">
                    <div>
                        <h3>What led here</h3>
                        {% if focus.upstream is empty %}<p class="muted">Nothing: this is where the flow starts.</p>{% else %}
                        <ol data-focus-upstream>{% for step in focus.upstream %}<li><a href="{{ step.href }}">{{ step.label }}</a> <span class="muted">{{ step.kind }} · {{ step.service }}</span></li>{% endfor %}</ol>
                        {% endif %}
                    </div>
                    <div>
                        <h3>What happens next</h3>
                        {% if focus.downstream is empty %}<p class="muted">Nothing: the flow ends here.</p>{% else %}
                        <ol data-focus-downstream>{% for step in focus.downstream %}<li><a href="{{ step.href }}">{{ step.label }}</a> <span class="muted">{{ step.kind }} · {{ step.service }}</span></li>{% endfor %}</ol>
                        {% endif %}
                    </div>
                </div>
            </details>
        {% endif %}
        <details class="card legend" data-graph-legend open>
            <summary>Legend</summary>
            <ul class="legend-items">
                <li data-legend="passed"><span class="pill ok sq">passed</span> the trace went through</li>
                <li data-legend="pending"><span class="pill wait sq">pending</span> sent, not processed yet</li>
                <li data-legend="failed"><span class="pill bad sq">failed</span> the step failed</li>
                <li data-legend="asynchronous"><b>⟹</b> asynchronous or distributed</li>
                <li data-legend="inferred"><b>⇢</b> inferred from source code</li>
                <li data-legend="crossed"><b class="ok">━</b> arrow the trace crossed</li>
            </ul>
            <table class="service-links">
                <thead><tr><th>Service</th><th>Dead letters</th><th>Traces</th></tr></thead>
                <tbody>
                {% for service in services %}
                    <tr data-service-link="{{ service }}"><th scope="row">{{ service }}</th><td><a data-dead-letters href="{{ path('dead_letters', {service: service}) }}">dead letters</a></td><td><a data-traces href="{{ path('traces') }}#service-{{ service }}">traces</a></td></tr>
                {% endfor %}
                </tbody>
            </table>
        </details>
    {% endif %}
{% endblock %}
