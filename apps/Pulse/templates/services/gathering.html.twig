{% extends 'base.html.twig' %}

{% block title %}Gathering · {{ service.service }} · Ecotone Pulse{% endblock %}

{% block head %}{% if waiting %}<meta http-equiv="refresh" content="3">{% endif %}{% endblock %}

{% block body %}
    {% include 'services/_header.html.twig' with {route: 'service_gathering', current: 'gathering', heading: 'Gathering', trail: [{label: 'Gathering'}]} %}
    {% if refusals %}
        {% for refusal in refusals %}<p class="notice toast drift" role="alert" data-gathering-error>{{ refusal.scope }} refused the gathering action: {{ refusal.message }}</p>{% endfor %}
    {% elseif action in ['release', 'discard'] and actionStatus == 'requested' %}
        <p class="notice toast" role="status" data-gathering-notice>{{ action == 'release' ? 'Release' : 'Discard' }} requested for group {{ groupId }}. {% if action == 'release' %}The handler runs when its consumer handles the release trigger.{% else %}The service closes the group without invoking its handler.{% endif %}</p>
    {% endif %}
    {% for scope in scopes %}
        {% if scope.snapshot.gathering.gathers ?? true %}
    <p>A group waits for its split parts. Requesting release queues a trigger; the gathered handler runs when its consumer handles that trigger. Discard closes the group without running the handler.</p>
        <section aria-label="Gathering groups{% if scope.tenant %} of {{ scope.tenant }}{% endif %}">
            {% if scope.tenant %}<h2>{{ scope.tenant }}</h2>{% endif %}
            {% set groups = scope.snapshot.gathering.groups ?? [] %}
            {% if not scope.hasSnapshot %}
                {% include '_empty.html.twig' with {cause: 'waiting', hook: 'no-snapshot', sentence: 'Waiting for the first answer of ' ~ scope.scope ~ '; this page refreshes until it arrives.', action: {href: tabs.overview, label: 'Open the overview of ' ~ service.service}} only %}
            {% elseif scope.snapshot.gathering is not defined %}
                <p>{{ scope.scope }} does not report gathering. Enable a gathered flow on a version of Ecotone that supports gathering, then refresh.</p>
            {% elseif groups is empty %}
                <p>No gathering groups reported.</p>
            {% else %}
                <div class="flush" style="overflow-x:auto" tabindex="0" role="region" aria-label="Gathering group progress">
                    <table>
                        <thead><tr><th scope="col">Group</th><th scope="col">Gather channel</th><th scope="col">State</th><th scope="col">Accounted parts</th><th scope="col">Missing parts</th><th scope="col">Deadline</th><th scope="col">Late parts</th><th scope="col">Operations</th></tr></thead>
                        <tbody>
                        {% for group in groups %}
                            <tr data-gathering-group="{{ group.groupId }}"{% if scope.tenant %} data-tenant="{{ scope.tenant }}"{% endif %}>
                                <th scope="row"><code>{{ group.groupId }}</code></th>
                                <td data-gather-channel>{{ group.gatherChannelName }}</td>
                                <td data-group-state>{{ group.state }}</td>
                                <td data-accounted-parts>{{ group.accountedPartNumbers|join(', ') ?: 'none' }} of {{ group.size }}</td>
                                <td data-missing-parts>{{ group.missingPartNumbers|join(', ') ?: 'none' }}</td>
                                <td data-group-deadline>{% if group.deadline is not null %}{{ (group.deadline / 1000)|date('c', 'UTC') }}{% else %}No timeout{% endif %}</td>
                                <td data-late-parts>{{ group.latePartCount }}</td>
                                <td>
                                    {% if group.state == 'open' %}
                                        <form method="post" action="{{ path('service_gathering_release', {service: scope.scope, groupId: group.groupId}) }}">
                                            <button type="submit" name="confirm" value="1" data-release-group>Request release</button>
                                        </form>
                                        <form method="post" action="{{ path('service_gathering_discard', {service: scope.scope, groupId: group.groupId}) }}">
                                            <button type="submit" name="confirm" value="1" data-discard-group>Discard</button>
                                        </form>
                                    {% else %}Closed{% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>
        {% endif %}
        {% set batches = scope.snapshot.gathering.batches ?? [] %}
        {% if scope.snapshot.gathering.batches is defined %}
            <section aria-label="Collected batches{% if scope.tenant %} of {{ scope.tenant }}{% endif %}">
                <h2>Collected batches{% if scope.tenant %} · {{ scope.tenant }}{% endif %}</h2>
                <p>Messages wait until the batch reaches its size or maximum wait. Request release to run a partial batch, or discard it without running its handler.</p>
                {% if batches is empty %}
                    <p data-no-collected-batches>No collected batches reported.</p>
                {% else %}
                <div class="flush" style="overflow-x:auto" tabindex="0" role="region" aria-label="Collected batch progress">
                    <table>
                        <thead><tr><th scope="col">Group id</th><th scope="col">Endpoint</th><th scope="col">Group key</th><th scope="col">State</th><th scope="col">Maximum size</th><th scope="col">Recorded messages</th><th scope="col">Opened at</th><th scope="col">Deadline</th><th scope="col">Release reason</th><th scope="col">Operations</th></tr></thead>
                        <tbody>
                        {% for batch in batches %}
                            <tr data-collected-batch="{{ batch.groupId }}"{% if scope.tenant %} data-tenant="{{ scope.tenant }}"{% endif %}>
                                <th scope="row"><code>{{ batch.groupId }}</code></th>
                                <td data-batch-endpoint>{{ batch.endpointId }}</td>
                                <td data-batch-key>{{ batch.groupKey ?? 'All messages' }}</td>
                                <td data-batch-state>{{ batch.state }}</td>
                                <td data-batch-size>{{ batch.maxSize ?? 'No maximum size' }}</td>
                                <td data-batch-recorded>{{ batch.recordedMessages }}</td>
                                <td data-batch-opened>{{ (batch.openedAt / 1000)|date('c', 'UTC') }}</td>
                                <td data-batch-deadline>{% if batch.deadline is not null %}{{ (batch.deadline / 1000)|date('c', 'UTC') }}{% else %}No maximum wait{% endif %}</td>
                                <td data-batch-release-reason>{{ batch.releaseReason ?? '' }}</td>
                                <td>
                                    {% if batch.state == 'open' %}
                                        <form method="post" action="{{ path('service_gathering_release', {service: scope.scope, groupId: batch.groupId}) }}">
                                            <button type="submit" name="confirm" value="1" data-release-group>Request release</button>
                                        </form>
                                        <form method="post" action="{{ path('service_gathering_discard', {service: scope.scope, groupId: batch.groupId}) }}">
                                            <button type="submit" name="confirm" value="1" data-discard-group>Discard</button>
                                        </form>
                                    {% else %}Closed{% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% endif %}
            </section>
        {% endif %}
    {% endfor %}
{% endblock %}
