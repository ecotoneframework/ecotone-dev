{% extends 'base.html.twig' %}

{% block title %}{{ service.service }} · Ecotone Pulse{% endblock %}

{% block head %}
    {% if waiting %}<meta http-equiv="refresh" content="3">{% endif %}
{% endblock %}

{% macro problemCard(card) %}
    {% if card.failureId %}<div data-failure="{{ card.failureId }}">{% endif %}
    {% embed '_problem.html.twig' with {status: card.severity, kind: card.kind, where: card.where, evidence: card.evidence, action: {label: card.actionLabel, href: card.actionHref}, concept: card.concept, parts: card.text} only %}
        {% block text %}{% for part in parts %}{% if part.title is defined %}<span title="{{ part.title }}">{{ part.text }}</span>{% else %}{{ part.text }}{% endif %}{% endfor %}{% endblock %}
    {% endembed %}
    {% if card.failureId %}</div>{% endif %}
{% endmacro %}

{% block body %}
    {% include 'services/_header.html.twig' with {service: service, tenant: tenant, trail: [], route: 'service_hub', tabs: tabs, current: 'overview', failureCount: failureCount} only %}

    <div data-hub-health data-hub-problems>
        {% embed '_verdict.html.twig' with {status: verdict.status, sentence: verdict.sentence, allClear: verdict.allClear, service: service} only %}
            {% block sentence %}{% if allClear %}<span data-all-clear>All clear</span>{{ sentence|slice(9) }}{% else %}{{ sentence }}{% endif %}{% endblock %}
            {% block meta %}
                <p class="verdict-meta" data-verdict-meta>
                    <span data-hub-status="{{ service.status.value }}">{{ service.status.value == 'channel_missing' ? 'Channel missing' : service.status.name }}</span>
                    · {% if service.hasSnapshot %}<span title="{{ service.lastSeenAt|date('Y-m-d H:i:s T') }}">last answer {{ service.ageSeconds }} s ago</span>{% else %}no answer yet{% endif %} {% include '_concept.html.twig' with {term: 'snapshot'} only %}
                    {% if service.hasSnapshot %}· <span data-hub-versions>Ecotone {{ service.ecotoneVersion ?? 'unknown' }} · PHP {{ service.snapshot.overview.phpVersion|default('unknown') }} · {{ service.snapshot.overview.framework|default('unknown framework') }} · {% if not service.snapshot.overview.licence.testing|default(false) %}licence expires {% endif %}{% include '_licence.html.twig' with {snapshot: service.snapshot} only %}</span>{% endif %}
                </p>
            {% endblock %}
        {% endembed %}
        {% if service.requestFailure %}<p class="drift" data-request-error>{{ service.requestFailure }}</p>{% endif %}
        {% set refusing = focus ?? service %}
        {% if refusing.refusalOf('ecotone.pulse.snapshot') %}<p class="drift" role="alert" data-snapshot-refusal>{{ refusing.scope }} refused the snapshot request: {{ refusing.refusalOf('ecotone.pulse.snapshot') }}</p>{% endif %}
        {% if service.replyError %}<p class="drift" data-reply-error>Reply rejected: {{ service.replyError }}</p>{% endif %}

        {% if failing %}
            <section class="card" id="diagnose" data-diagnose-section>
                <h2>Diagnose</h2>
                {% if diagnosis.skipped %}<p class="muted" data-checks-skipped>The broker checks did not fit the time budget and were skipped. Run <code>bin/console pulse:doctor</code> in the container for the full result, or raise <code>PULSE_DOCTOR_BUDGET_SECONDS</code> (default 8).</p>{% endif %}
                <ul data-checks>
                    {% for check in diagnosis.checks %}
                        <li data-check="{{ check.name }}" data-check-status="{{ check.status }}"><b>{{ check.status|upper }}</b> {{ check.name }}: {{ check.message }}{% if check.fix %}<br><span class="muted">{{ check.fix }}</span>{% endif %}</li>
                    {% endfor %}
                </ul>
                <details data-disclosure="hub.{{ service.service }}.diagnose-checklist">
                    <summary>What {{ service.service }} needs to answer · 4 requirements</summary>
                    <ul data-diagnose-list>
                        <li>The service must run <code>ecotone:run {{ service.channel }}</code> to consume the channel Pulse writes to.</li>
                        <li><code>PULSE_SERVICES</code> must map <code>{{ service.service }}</code> to that channel.</li>
                        <li>The service needs an Ecotone Enterprise licence key. A service without one cannot answer, and shows here as Unreachable with no other reason.</li>
                        <li>Both must reach the same broker as <code>PULSE_TRANSPORT_DSN</code>.</li>
                    </ul>
                </details>
                <h3>Connect {{ service.service }}</h3>
                {% include 'connect/_snippets.html.twig' with {snippets: snippets, servicesEntry: servicesEntry} only %}
            </section>
        {% endif %}

        {% for card in problems|slice(0, problemsShown) %}{{ _self.problemCard(card) }}{% endfor %}
        {% if problems|length > problemsShown %}
            <details class="more-problems" data-more-problems data-disclosure="hub.{{ service.service }}.more-problems">
                <summary>{{ problems|length - problemsShown }} more {{ problems|length - problemsShown == 1 ? 'problem' : 'problems' }}</summary>
                {% for card in problems|slice(problemsShown) %}{{ _self.problemCard(card) }}{% endfor %}
            </details>
        {% endif %}
    </div>

    {% if service.hasSnapshot %}
        <div class="tiles summary-tiles">
            {% for tile in summaryTiles %}
                <div class="tile-slot" {{ {channels: 'data-hub-channel-summary', 'dead-letters': 'data-hub-dead-letters', projections: 'data-hub-projections', traces: 'data-hub-flow-types'}[tile.kind] }}>
                    {% include '_tile.html.twig' with {kind: tile.kind, href: tile.href, label: tile.label, count: tile.count, noun: tile.noun, state: tile.state, status: tile.status, detail: tile.detail, concept: tile.concept} only %}
                </div>
            {% endfor %}
        </div>

        {% if focus is null and (service.isMultiTenant or service.unadvertisedTenants) %}
            <section class="card" data-hub-tenants>
                <h2>Tenants · {{ tenantRows|length }}</h2>
                {% if service.isMultiTenant %}<p class="muted">{% include '_concept.html.twig' with {term: 'tenant', text: 'Each tenant'} only %} is asked for separately, in header <code>{{ service.tenantHeader }}</code>. Pick one above to see its failures, projections and traces.</p>{% endif %}
                {% include '_tenants.html.twig' with {tenantRows: tenantRows, service: service} only %}
            </section>
        {% endif %}

        <div id="channels">
            {% if channels is empty %}
                {% include '_empty.html.twig' with {cause: 'nothing-yet', sentence: service.service ~ ' reports no pollable message channel, so no message waits between a sender and its handler. A channel appears here once a handler is marked #[Asynchronous(\'name\')].'} only %}
            {% else %}
                {% embed '_section.html.twig' with {key: 'hub.' ~ service.service ~ '.flow', title: 'How messages move through ' ~ service.service, summary: channelsSummary, status: channelsStatus, concept: 'consumer', channels: channels, tabs: tabs} only %}
                    {% block body %}
                        <ul class="flow-chains">
                            {% for channel in channels %}
                                <li>
                                    <ol class="where" data-flow-channel="{{ channel.name }}">
                                        <li title="{{ channel.kind == 'async' ? 'asynchronous channel of #[Asynchronous] handlers' : 'message channel' }}">{{ channel.name }}</li>
                                        <li>{% if channel.runCommand %}<code>{{ channel.runCommand }}</code>{% else %}no polling consumer{% endif %}</li>
                                        <li>{% if channel.handlers is empty %}no asynchronous handler{% else %}{{ channel.handlers|length }} {{ channel.handlers|length == 1 ? 'handler' : 'handlers' }}{% endif %}</li>
                                    </ol>
                                </li>
                            {% endfor %}
                        </ul>
                        <p class="muted">A message that still fails after its retries is kept: <a href="{{ tabs.failures }}">open it from Failed messages</a> to reach its trace.</p>
                    {% endblock %}
                {% endembed %}
            {% endif %}
        </div>

        <p data-hub-graph><a href="{{ path('flow_graph', {services: [service.service]}) }}">See {{ service.service }} on the flow graph</a></p>
    {% endif %}
{% endblock %}
