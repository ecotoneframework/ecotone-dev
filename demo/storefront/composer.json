{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "ecotone/demo-storefront",
    "type": "project",
    "description": "Ecotone demo: the Laravel storefront",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=8.5",
        "ecotone/amqp": "2.0.x-dev",
        "ecotone/dbal": "2.0.x-dev",
        "ecotone/jms-converter": "2.0.x-dev",
        "ecotone/laravel": "2.0.x-dev",
        "ecotone/open-telemetry": "2.0.x-dev",
        "laravel/framework": "^12.0",
        "nyholm/psr7": "^1.8",
        "open-telemetry/exporter-otlp": "^1.0",
        "open-telemetry/sdk": "^1.0",
        "symfony/http-client": "^7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "tests:ci": [
            "vendor/bin/phpstan analyse --no-progress",
            "vendor/bin/phpunit --no-coverage"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
