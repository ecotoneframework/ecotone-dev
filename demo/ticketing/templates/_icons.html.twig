{% macro icon(name) %}
    <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        {%- if name == 'logo' -%}
            <path d="M3 8a2 2 0 0 0 2-2h14a2 2 0 0 0 2 2v2a2 2 0 0 0 0 4v2a2 2 0 0 0-2 2H5a2 2 0 0 0-2-2v-2a2 2 0 0 0 0-4z"/><path d="M14 6v12" stroke-dasharray="2 2"/>
        {%- elseif name == 'home' -%}
            <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"/>
        {%- elseif name == 'calendar' -%}
            <rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/>
        {%- elseif name == 'building' -%}
            <path d="M4 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"/><path d="M16 9h2a2 2 0 0 1 2 2v10M2 21h20M8 7h4M8 11h4M8 15h4"/>
        {%- elseif name == 'seats' -%}
            <path d="M5 11V7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v4"/><path d="M3 11h18v4H3zM5 15v4M19 15v4"/>
        {%- elseif name == 'pulse' -%}
            <path d="M3 12h4l3-8 4 16 3-8h4"/>
        {%- elseif name == 'trace' -%}
            <path d="M4 6h10M8 12h12M6 18h8"/><circle cx="17" cy="6" r="1"/><circle cx="5" cy="12" r="1"/><circle cx="17" cy="18" r="1"/>
        {%- elseif name == 'check' -%}
            <circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/>
        {%- elseif name == 'alert' -%}
            <path d="M12 3 2 20h20z"/><path d="M12 10v4M12 17h.01"/>
        {%- elseif name == 'play' -%}
            <path d="m7 4 13 8-13 8z"/>
        {%- elseif name == 'tag' -%}
            <path d="M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9z"/><circle cx="8" cy="8" r="1.5"/>
        {%- elseif name == 'x' -%}
            <circle cx="12" cy="12" r="9"/><path d="m9 9 6 6M15 9l-6 6"/>
        {%- elseif name == 'plus' -%}
            <path d="M12 5v14M5 12h14"/>
        {%- elseif name == 'arrow' -%}
            <path d="M5 12h14M13 6l6 6-6 6"/>
        {%- elseif name == 'star' -%}
            <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1 6.2L12 17.3 6.5 20.2l1-6.2L3 9.6l6.2-.9z"/>
        {%- endif -%}
    </svg>
{% endmacro %}
