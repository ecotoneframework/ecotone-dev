			identifier: return.type
			count: 1
			path: src/EntityManagerRegistryEmulator.php

		-
			message: '#^Method Ecotone\\Dbal\\EntityManagerRegistryEmulator\:\:getConnections\(\) should return array\<string, object\> but returns array\<int, Doctrine\\DBAL\\Connection\>\.$#'
			identifier: return.type
			count: 1
			path: src/EntityManagerRegistryEmulator.php

		-
			message: '#^Method Ecotone\\Dbal\\EntityManagerRegistryEmulator\:\:getManagerNames\(\) should return array\<string, string\> but returns array\<int, string\>\.$#'
			identifier: return.type
			count: 1
			path: src/EntityManagerRegistryEmulator.php

		-
			message: '#^Method Ecotone\\Dbal\\EntityManagerRegistryEmulator\:\:getManagers\(\) should return array\<string, Doctrine\\Persistence\\ObjectManager\> but returns array\<int, Doctrine\\ORM\\EntityManagerInterface\>\.$#'
			identifier: return.type
			count: 1
			path: src/EntityManagerRegistryEmulator.php

		-
			message: '#^Call to an undefined method Interop\\Queue\\Context\:\:getDbalConnection\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/ManagerRegistryEmulator.php

		-
			message: '#^Method Ecotone\\Dbal\\ManagerRegistryEmulator\:\:getConnectionNames\(\) should return array\<string, string\> but returns array\<int, string\>\.$#'
			identifier: return.type
			count: 1
			path: src/ManagerRegistryEmulator.php

		-
			message: '#^Method Ecotone\\Dbal\\ManagerRegistryEmulator\:\:getConnections\(\) should return array\<string, object\> but returns array\<int, Doctrine\\DBAL\\Connection\>\.$#'
			identifier: return.type
			count: 1
			path: src/ManagerRegistryEmulator.php

		-
			message: '#^Method Ecotone\\Dbal\\ManagerRegistryEmulator\:\:getManagerNames\(\) should return array\<string, string\> but returns array\<int, string\>\.$#'
			identifier: return.type
			count: 1
			path: src/ManagerRegistryEmulator.php

		-
			message: '#^Call to an undefined method Interop\\Queue\\ConnectionFactory\:\:getRegistry\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/MultiTenant/HeaderBasedMultiTenantConnectionFactory.php

		-
			message: '#^PHPDoc tag @param for parameter \$container with type array\<string, Interop\\Queue\\ConnectionFactory\> is incompatible with native type Psr\\Container\\ContainerInterface\.$#'
			identifier: parameter.phpDocType
			count: 1
			path: src/MultiTenant/HeaderBasedMultiTenantConnectionFactory.php

		-
			message: '#^PHPDoc type for property Ecotone\\Dbal\\MultiTenant\\HeaderBasedMultiTenantConnectionFactory\:\:\$container with type array\<string, Interop\\Queue\\ConnectionFactory\> is incompatible with native type Psr\\Container\\ContainerInterface\.$#'
			identifier: property.phpDocType
			count: 1
			path: src/MultiTenant/HeaderBasedMultiTenantConnectionFactory.php

		-
			message: '#^Method Ecotone\\Dbal\\ObjectManager\\ObjectManagerModule\:\:create\(\) should return static\(Ecotone\\Dbal\\ObjectManager\\ObjectManagerModule\) but returns Ecotone\\Dbal\\ObjectManager\\ObjectManagerModule\.$#'
			identifier: return.type
			count: 1
			path: src/ObjectManager/ObjectManagerModule.php

		-
			message: '#^Method Ecotone\\Dbal\\Recoverability\\DbalDeadLetterModule\:\:create\(\) should return static\(Ecotone\\Dbal\\Recoverability\\DbalDeadLetterModule\) but returns Ecotone\\Dbal\\Recoverability\\DbalDeadLetterModule\.$#'
