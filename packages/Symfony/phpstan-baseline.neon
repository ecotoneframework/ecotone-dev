parameters:
	ignoreErrors:
		-
			message: '#^Call to an undefined method Psr\\Container\\ContainerInterface\:\:getParameter\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: DependencyInjection/Compiler/SymfonyConfigurationVariableService.php

		-
			message: '#^Call to an undefined method Psr\\Container\\ContainerInterface\:\:hasParameter\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: DependencyInjection/Compiler/SymfonyConfigurationVariableService.php

		-
			message: '#^Call to an undefined method Symfony\\Component\\Config\\Definition\\Builder\\NodeDefinition\:\:children\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: DependencyInjection/Configuration.php
