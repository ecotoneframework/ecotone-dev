{
    "name": "ecotone/quickstart",
    "license": "MIT",
    "authors": [
        {
            "name": "Dariusz Gafka",
            "email": "dgafka.mail@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../../../packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\MultiTenant\\": "src"
        }
    },
    "require": {
        "ecotone/dbal": "~2.0.0-beta.4",
        "ecotone/jms-converter": "~2.0.0-beta.4",
        "ecotone/symfony-bundle": "~2.0.0-beta.4",
        "symfony/orm-pack": "^2.4",
        "symfony/yaml": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "doctrine/orm": "^3.0",
        "phpunit/phpunit": "^9.6|^10.5|^11.0"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
