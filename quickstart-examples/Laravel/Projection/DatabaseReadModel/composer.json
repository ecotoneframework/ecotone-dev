{
    "name": "ecotone/quickstart",
    "license": "MIT",
    "authors": [
        {
            "name": "Dariusz Gafka",
            "email": "dgafka.mail@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../../../../packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app"
        }
    },
    "require": {
        "ecotone/dbal": "~1.328.3",
        "ecotone/jms-converter": "~1.328.3",
        "ecotone/laravel": "~1.328.3",
        "ecotone/laravel-starter": "^1.1.0",
        "ecotone/lite-application": "~1.328.3",
        "ecotone/lite-event-sourcing-starter": "^1.0",
        "ecotone/pdo-event-sourcing": "~1.328.3",
        "laravel/laravel": "^12.0",
        "ramsey/uuid": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6|^10.5|^11.0"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
