{
    "name": "ecotone/quickstart",
    "license": "MIT",
    "authors": [
        {
            "name": "Dariusz Gafka",
            "email": "dgafka.mail@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../../../../packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\MultiTenant\\": "src"
        }
    },
    "require": {
        "doctrine/orm": "^3.3",
        "doctrine/persistence": "^4.0",
        "ecotone/dbal": "~2.0.0-beta.2",
        "ecotone/jms-converter": "~2.0.0-beta.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6|^10.5|^11.0"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
